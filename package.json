{
  "name": "zerogfileman",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first multi-pane voice-enabled file manager",
  "license": "MIT",
  "author": "Stephen Phillips",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HappyMonkeyAI/ZeroGFileMan.git"
  },
  "bugs": {
    "url": "https://github.com/HappyMonkeyAI/ZeroGFileMan/issues"
  },
  "homepage": "https://github.com/HappyMonkeyAI/ZeroGFileMan#readme",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.json && node scripts/copy-preload.mjs && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node scripts/start-electron.mjs",
    "start:electron-cli": "electron .",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^43.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.happymonkeyai.zerogfileman",
    "productName": "ZeroG FileMan",
    "asar": true,
    "files": ["dist/**/*", "package.json"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "signAndEditExecutable": false
    }
  }
}
