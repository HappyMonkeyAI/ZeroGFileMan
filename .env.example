# Local OpenAI-compatible LLM (LM Studio / Unsloth). Never commit real keys.
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_API_KEY=lm-studio
# Hash id from LM Studio when the friendly name is missing (Kestrel 4B coder).
LOCAL_LLM_MODEL=<lm-studio-model-id>

# Optional OpenAI-compatible speech transcription server (not the chat LLM).
# SPEECH_SERVER_URL=http://127.0.0.1:8080/v1/audio/transcriptions
# SPEECH_SERVER_MODEL=whisper-1
